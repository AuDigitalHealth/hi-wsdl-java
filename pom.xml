    <profiles>
        <!-- Maintainer: mvn -B -Pregenerate-sources -Dhi.wsdl.codegen.clean=true generate-sources process-sources -->
        <!-- Optional commit sync: add -Dhi.wsdl.sync.generated=true -->
        <profile>
            <id>regenerate-sources</id>
            <properties>
                <hi.wsdl.codegen.skip>false</hi.wsdl.codegen.skip>
                <jaxb.xjc.version>4.0.7</jaxb.xjc.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.gmavenplus</groupId>
                        <artifactId>gmavenplus-plugin</artifactId>
                        <version>${gmavenplus.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>clean-wsimport-codegen</id>
                                <phase>generate-sources</phase>
                                <goals><goal>execute</goal></goals>
                                <configuration>
                                    <skipScriptExecution>${hi.wsdl.codegen.skip}</skipScriptExecution>
                                    <scripts>
                                        <script><![CDATA[
                                            def clean = project.properties.getProperty('hi.wsdl.codegen.clean', 'false')
                                            if (!'true'.equalsIgnoreCase(clean.trim())) {
                                                return
                                            }
                                            def bd = project.build.directory as File
                                            def partsBase = new File(bd, 'generated-sources/wsimport-parts')
                                            if (partsBase.isDirectory()) {
                                                partsBase.eachDir { File sub -> sub.deleteDir() }
                                                partsBase.deleteDir()
                                            }
                                            def destBase = new File(bd, 'jaxws/dest')
                                            if (destBase.isDirectory()) {
                                                destBase.eachDir { File sub -> sub.deleteDir() }
                                            }
                                            def merged = new File(bd, 'generated-sources/wsimport')
                                            if (merged.isDirectory()) {
                                                merged.deleteDir()
                                            }
                                            def jaxwsDir = new File(bd, 'jaxws')
                                            if (jaxwsDir.isDirectory()) {
                                                jaxwsDir.deleteDir()
                                            }
                                        ]]></script>
                                    </scripts>
                                </configuration>
                            </execution>
                            <execution>
                                <id>merge-wsimport</id>
                                <phase>process-sources</phase>
                                <goals><goal>execute</goal></goals>
                                <configuration>
                                    <skipScriptExecution>${hi.wsdl.codegen.skip}</skipScriptExecution>
                                    <scripts>
                                        <script><![CDATA[
                                            def bd = project.build.directory as File
                                            def out = new File(bd, 'generated-sources/wsimport')
                                            out.mkdirs()
                                            def base = new File(bd, 'generated-sources/wsimport-parts')
                                            def names = [
                                        'wsimport-consumer-search-ihi',
                                        'wsimport-consumer-search-ihi-batch-sync',
                                        'wsimport-provider-batch-async-individual',
                                        'wsimport-provider-batch-async-organisation',
                                        'wsimport-provider-search-individual',
                                        'wsimport-provider-search-organisation',
                                        'wsimport-provider-manage-org',
                                        'wsimport-provider-manage-directory-entry',
                                        'wsimport-provider-hpio-directory',
                                        'wsimport-provider-read-reference-data',
                                        'wsimport-provider-read-org',
                                        'wsimport-provider-manage-admin-individual',
                                        'wsimport-provider-read-admin-individual',
                                        'wsimport-provider-hpii-directory',
                                        'wsimport-consumer-search-ihi-batch-async',
                                        'wsimport-consumer-create-provisional-ihi',
                                        'wsimport-consumer-merge-provisional-ihi',
                                        'wsimport-consumer-update-provisional-ihi',
                                        'wsimport-consumer-create-unverified-ihi',
                                        'wsimport-consumer-resolve-provisional-ihi',
                                        'wsimport-consumer-notify-duplicate-ihi',
                                        'wsimport-consumer-notify-replica-ihi',
                                        'wsimport-consumer-update-ihi',
                                        'wsimport-consumer-create-verified-ihi',
                                        'wsimport-provider-manage-tds-provider-individual',
                                        'wsimport-provider-search-tds-provider-individual'
                                            ]
                                            names.each { String part ->
                                                def dir = new File(base, part)
                                                if (!dir.isDirectory()) return
                                                dir.eachFileRecurse(groovy.io.FileType.FILES) { File f ->
                                                    def rel = dir.toPath().relativize(f.toPath()).toString().replace('\\', '/')
                                                    def target = new File(out, rel)
                                                    target.parentFile.mkdirs()
                                                    if (!target.exists()) {
                                                        f.withInputStream { ins -> target.withOutputStream { os -> os << ins } }
                                                    }
                                                }
                                            }
                                            if ('true'.equalsIgnoreCase(project.properties.getProperty('hi.wsdl.sync.generated', 'false').trim())) {
                                                def srcMain = new File(project.basedir, 'src/main/java')
                                                out.eachFileRecurse(groovy.io.FileType.FILES) { File f ->
                                                    if (!f.name.endsWith('.java')) return
                                                    def rel = out.toPath().relativize(f.toPath()).toString().replace('\\', '/')
                                                    def target = new File(srcMain, rel)
                                                    target.parentFile.mkdirs()
                                                    f.withInputStream { ins -> target.withOutputStream { os -> os << ins } }
                                                }
                                                log.info('Synced generated sources to src/main/java')
                                            }
                                            project.getCompileSourceRoots().findAll { String p -> p.contains('wsimport-parts') }.each { project.removeCompileSourceRoot(it) }
                                        ]]></script>
                                    </scripts>
                                </configuration>
                            </execution>
                        </executions>
